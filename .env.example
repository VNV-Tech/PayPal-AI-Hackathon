# Copia este archivo a .env (en la raíz del repo) y rellena los valores.
# Nunca subas .env a git.
PORT=3000
# Dirección pública de la app, para los links que se le mandan al cliente
# (datos fiscales). Opcional: en local se usa http://localhost:5173 y en
# Render se detecta sola.
PUBLIC_URL=

# PayPal Sandbox: credenciales de la app en la cuenta Business de Sandbox
# https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# ID del webhook (obligatorio en producción). Se llena solo con:
#   npm run paypal:webhook -- https://tu-url-publica
PAYPAL_WEBHOOK_ID=
# Solo para probar webhooks en tu máquina sin PAYPAL_WEBHOOK_ID. Nunca en Render.
PAYPAL_SKIP_WEBHOOK_VERIFY=false

# Nombre de tu negocio (opcional): sale en tus facturas de PayPal y en la
# página donde tu cliente deja sus datos fiscales, para que sepa quién se los pide
BUSINESS_NAME=

# Facturama Sandbox (facturas fiscales CFDI de prueba). Opcional: sin esto la
# app funciona igual y solo se desactiva "Issue CFDI". Es el usuario (no el
# correo) y la contraseña de https://dev.facturama.mx
FACTURAMA_USER=
FACTURAMA_PASSWORD=
# Código postal del lugar de expedición dado de alta en Facturama
FACTURAMA_EXPEDITION_PLACE=42501

# Claude (Anthropic) https://console.anthropic.com
ANTHROPIC_API_KEY=
# Modelo del chat (opcional). Opciones: claude-opus-5-5 (mejor), claude-sonnet-5-5 (la mitad de precio), claude-haiku-5-5 (el más barato)
ANTHROPIC_MODEL=claude-opus-5-5
# Máximo de llamadas a Claude por día, para proteger los créditos (opcional)
CHAT_DAILY_LIMIT=200
