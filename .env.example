# Copia este archivo a .env (en la raíz del repo) y rellena los valores.
# Nunca subas .env a git.
PORT=3000

# PayPal Sandbox: credenciales de la app en la cuenta Business de Sandbox
# https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# ID del webhook registrado en el dashboard (obligatorio en producción)
PAYPAL_WEBHOOK_ID=
# Solo para probar webhooks en tu máquina sin PAYPAL_WEBHOOK_ID. Nunca en Render.
PAYPAL_SKIP_WEBHOOK_VERIFY=false

# Claude (Anthropic) https://console.anthropic.com
ANTHROPIC_API_KEY=
